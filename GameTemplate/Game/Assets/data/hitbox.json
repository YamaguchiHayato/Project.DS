// 部位別の当たり判定表。
// このファイルを書き換えて保存し、ゲームを起動し直せば反映される(リビルド不要)。
//
// ・キー("Infected"/"Survivor")はキャラクターの種別。
// ・parts は人型を「縦に積んだ円柱」で近似したもの。
//   bottom/top は足元(0)から測った高さ、radius は水平方向の被弾半径。
//   キャラクターがどちらを向いていても同じ判定になるので、向きの情報は要らない。
// ・part は "Head"/"Body"/"Leg" のいずれか。書き間違えたその行は捨てられる。
// ・damageRate は部位ごとのダメージ倍率。ヘッドショットの強さはここで調整する。
//
// ⚠寸法は「画面に出ているモデルの実寸」に合わせること。想定の身長ではない。
//   unityChan は素のスケールだと身長が約76しかない(髪リボン込みで118.6)。
{
	"hitBoxSets": {
		// 雑魚ゾンビ。
		// ⚠CommonEnemy は unityChan をスケール1のまま使っているので、実寸(身長約76)に合わせてある。
		//   敵モデルを差し替える、または SetScale で大きくしたら、ここも同じ倍率で直すこと。
		//   (例: 敵を2.3倍にするなら Survivor と同じ値にする)
		"Infected": {
			"damageRate": {
				"Head": 2.0,	// 頭。弱点。
				"Body": 1.0,	// 胴と腕。
				"Leg": 0.7		// 脚。当てても効きが悪い。
			},
			"parts": [
				{ "part": "Head", "bottom": 62.0, "top": 78.0, "radius": 10.0 },
				{ "part": "Body", "bottom": 38.0, "top": 62.0, "radius": 17.0 },
				{ "part": "Leg",  "bottom":  0.0, "top": 38.0, "radius": 13.0 }
			]
		},

		// サバイバー(プレイヤー)。
		// player.json の bodyModelScale=2.3 で身長約175になるので、その寸法に合わせてある。
		"Survivor": {
			"damageRate": {
				"Head": 2.0,
				"Body": 1.0,
				"Leg": 0.7
			},
			"parts": [
				{ "part": "Head", "bottom": 143.0, "top": 179.0, "radius": 23.0 },
				{ "part": "Body", "bottom":  87.0, "top": 143.0, "radius": 39.0 },
				{ "part": "Leg",  "bottom":   0.0, "top":  87.0, "radius": 30.0 }
			]
		}
	}
}
