/**
 * @file   player.json
 * @brief  プレイヤー(サバイバー)のステータス表。
 *         書き換えて保存し、ゲームを起動し直せば反映される(リビルド不要)。
 *         項目が無い/型が違う場合は、その値だけ PlayerStatusTable.cpp の既定値が使われる。
 * @author Izumida Kiryu
 * @date   2026/09/02
 * @note   距離・長さの単位はゲーム内単位(人の身長が175)。時間の単位は秒。角度はラジアン。
 */
{
	/* 基本のステータス。*/
	"maxHP": 100,                                       //! 最大HP。
	"moveSpeed": 200.0,                                 //! 歩きの移動速度(1秒あたり)。
	"sprintRate": 1.6,                                  //! スプリント中の移動速度の倍率。
	"eyeHeight": 160.0,                                 //! 目(カメラ)の高さ。射撃の起点とカメラ位置に使う。
	"weaponRange": 3000.0,                              //! ヒットスキャンの射程。

	/* 見た目。三人称(他プレイヤーから見た姿)で使う。*/
	"bodyModelScale": 2.3,                              //! 体モデルの表示スケール。unityChanは素で身長約76しかないので世界の想定(175)へ合わせる。
	"handBoneName": "Character1_LeftHand",              //! 銃を持たせるボーン名。unityChanは左右の名前が反転していて"LeftHand"が見た目の右手になる。

	/* ダウンと救助。*/
	"bleedOutTime": 15.0,                               //! ダウンしてから死亡するまでの出血時間。
	"reviveHP": 1,                                      //! 救助で復帰したときの恒久HP。残りは一時体力(health.reviveTempHP)で補う。

	/* しゃがみ(Ctrl)。*/
	"crouchEyeHeight": 100.0,                           //! しゃがんだときの目の高さ。
	"crouchSpeedRate": 0.5,                             //! しゃがみ中の移動速度の倍率。

	/* 突き飛ばし(近接)。*/
	"shoveRange": 180.0,                                //! 突き飛ばしが届く距離。
	"shovePush": 120.0,                                 //! 突き飛ばしで敵を押し返す距離。
	"shoveFrontDot": 0.5,                               //! 正面判定のしきい値(0.5=正面±60度)。
	"shoveCooldownTime": 0.7,                           //! 突き飛ばしのクールダウン。
	"shoveFatigueCount": 5,                             //! 続けて押せる回数。これを超えると疲れて間が長くなる(本家の押し返し疲労)。
	"shoveFatigueCooldownTime": 1.8,                    //! 疲れているときのクールダウン。
	"shoveFatigueRecoverTime": 2.0,                     //! 押さずにいると疲労が1回ぶん抜けるまでの時間。
	"shoveMotionForward": 16.0,                         //! 押したときに銃を前へ突き出す距離(見た目)。
	"shoveMotionUp": 6.0,                               //! 押したときに銃を上へ振る距離(見た目)。
	"shoveMotionRecoverRate": 7.0,                      //! 突き出した銃が戻る速さ。

	/* 開始時の所持品。*/
	"medkitCount": 1,                                   //! 開始時に持っている回復アイテムの数。
	"pipeBombCount": 2,                                 //! 開始時に持っているパイプ爆弾の数。
	"startQuickItem": "Pills",                          //! 開始時に持っている即効アイテム。"Pills"(鎮痛剤) / "Adrenaline"(アドレナリン) / "None"。

	/**
	 * @brief L4D2式の体力ルール。
	 *        体力は「恒久HP」と、時間で減っていく「一時体力」の2階建て。ダメージは一時体力から先に削られる。
	 *        メディキットは恒久HPを、鎮痛剤・アドレナリンは一時体力を増やす。
	 */
	"health": {
		"tempHPDecayRate": 0.5,                         //! 一時体力が1秒あたりに減る量。50なら100秒でなくなる。

		"medkitUseTime": 3.0,                           //! メディキットを使い切るまでに押し続ける時間(秒)。途中で動くと最初からになる。
		"medkitHealRate": 0.8,                          //! 失った恒久HPのうち回復する割合(L4D2と同じ80%)。

		"pillsTempHP": 50,                              //! 鎮痛剤で増える一時体力。
		"adrenalineTempHP": 25,                         //! アドレナリンで増える一時体力。
		"adrenalineTime": 15.0,                         //! アドレナリンの効果時間(秒)。
		"adrenalineSpeedRate": 1.3,                     //! 効果中の移動速度の倍率。負傷歩行も無視する。
		"adrenalineActionRate": 1.5,                    //! 効果中のリロード・回復の速さの倍率。

		"limpHP": 40,                                   //! 合計HP(恒久＋一時)がこれ未満で足を引きずる。
		"limpSpeedRate": 0.68,                          //! 足を引きずるときの移動速度の倍率。
		"criticalHP": 10,                               //! 合計HPがこれ以下で瀕死。さらに遅くなる。
		"criticalSpeedRate": 0.4,                       //! 瀕死のときの移動速度の倍率。

		"maxReviveCount": 2,                            //! メディキットを使わずに復帰できる回数。使い切ると白黒になり、次のダウンで死亡する。
		"reviveTempHP": 30,                             //! 復帰したときに得る一時体力。
		"downEyeHeight": 60.0,                          //! ダウン中の目の高さ。倒れているので低くなる。
		"downDamageTimeRate": 0.15,                     //! ダウン中に受けたダメージ1あたりに縮む出血時間(秒)。殴られ続けると早く死ぬ。
		"eyeHeightFollowRate": 10.0                     //! 目の高さが目標(立ち/ダウン)へ移る速さ。
	},

	/**
	 * @brief 姿勢と移動で弾の拡散がどれだけ変わるか。
	 *        本家は動きながら撃つと大きくばらつき、しゃがむと締まる。腰だめでも止まって撃てば当たる、という感触を作る。
	 */
	"accuracy": {
		"moveSpreadRate": 1.8,                          //! 歩きながら撃つときの拡散の倍率。
		"sprintSpreadRate": 2.6,                        //! 走りながら撃つときの拡散の倍率。
		"crouchSpreadRate": 0.55,                       //! しゃがんで撃つときの拡散の倍率(1より小さいと締まる)。
		"spreadFollowRate": 10.0                        //! 倍率が切り替わる速さ。クロスヘアが一瞬で跳ねないように鈍らせる。
	},

	/**
	 * @brief 歩きと視点移動で生まれる揺れ。
	 *        「歩いている感じ」を作るところなので、触りながら詰められるよう外へ出してある。
	 */
	"viewShake": {
		"swayGain": 28.0,                               //! 視点を1ラジアン振ったときに銃がずれる距離。大きいほど遅れてついてくる。
		"swayMaxOffset": 10.0,                          //! 銃のずれの上限。これ以上は離れない。
		"swayRecoverRate": 9.0,                         //! ずれた銃が中央へ戻る速さ。
		"swayRollRate": 0.010,                          //! 銃のずれ1単位あたりの傾き。

		"bobWalkSpeed": 9.0,                            //! 歩きのボブの速さ。
		"bobWalkAmp": 2.0,                              //! 歩きで銃が横に振れる幅。
		"bobSprintSpeed": 13.0,                         //! 走りのボブの速さ。
		"bobSprintAmp": 4.0,                            //! 走りで銃が横に振れる幅。
		"bobPhaseLag": 0.55,                            //! 銃のボブをカメラより遅らせる位相。0にするとカメラと同時に動いて揺れが消える。
		"bobWeaponUpRate": 0.6,                         //! 銃のボブの縦の振れ幅(横に対する比)。横1・縦2の8の字を描く。
		"bobWeightRate": 8.0,                           //! ボブの重みが移り変わる速さ。止まった瞬間にピタッと消さないための鈍らせ。

		"viewBobHeightWalk": 1.6,                       //! 歩きでカメラが上下する量。体が動くので「歩いている感じ」が出る。
		"viewBobHeightSprint": 3.0,                     //! 走りでカメラが上下する量。
		"viewBobRollWalk": 0.010,                       //! 歩きでカメラが傾く角度。
		"viewBobRollSprint": 0.020,                     //! 走りでカメラが傾く角度。

		"strafeRollAngle": 0.035,                       //! 横移動でカメラが傾く角度(約2度)。傾く向きが逆に感じたら符号を反転する。
		"strafeFollowRate": 6.0,                        //! 横移動の傾きが追いつく速さ。
		"adsSuppressRate": 0.7                          //! 覗き込み中に揺れを抑える割合。1.0で完全に止まる。
	},

	/**
	 * @brief リロード演出「マガジンを抜く→挿す→構え直す」の振れ幅。
	 * @note  段階の区切り(いつ抜き終わるか等)は動きの構造なので Player.cpp の kReload* に置いている。
	 */
	"reload": {
		"lowerDown": 14.0,                              //! 抜くときに銃を下げる距離。
		"lowerAngle": 0.5,                              //! 抜くときに銃口を下げる角度。
		"pullBack": 14.0,                               //! 抜くときに銃を手前へ引く距離。
		"pullRight": 10.0,                              //! 抜くときに銃を画面中央へ寄せる距離。
		"rollAngle": 0.75,                              //! 差込口が見えるよう銃を傾ける角度。
		"insertUp": 9.0,                                //! マガジンを挿し込むときに突き上げる距離。
		"insertAngle": 0.16,                            //! 挿し込むときに銃口が上を向く角度。
		"settleUp": 4.0                                 //! 構え直したときに行き過ぎる距離。
	}
}
